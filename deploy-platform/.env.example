# docker compose 同级。复制为 .env 即可启动，不必先改。
# 不要把填了值的 .env 提交进 Git。
#
# 下面是试用默认值，和源码一起公开。生产或对外服务请整份换成自己的随机串后
# `docker compose up -d`。已经在跑的环境不要换 JWT / AES，否则要重新登录、
# Git 凭证要重录。改 MySQL / Redis 口令若数据卷已存在，要 `down -v` 后重来。
JWT_SECRET=s-CWJIQchAl5tt9iZtN00F1Xx11z_LL8Yjirh1w7GpQxL_d82UootdE5pKBobRsf
AES_KEY=hSfSy8kVkzSHIJVXpuI2WRPJietxJCJs-Vu5J0GGZxg
HARNESS_RUNNER_TOKEN=8U-ISm_JxDSSzk62j8CmVU8usgptM3GwJIq08V3sPWa_cSX7vY3xMZE_UsJkR8Bp
#
# 两处 MySQL 口令必须相同。主机名只能写 mysql（Compose 容器名），
# 不要写成服务器局域网 IP / 127.0.0.1，否则会连到机上别的 MySQL，报 1045。
MYSQL_ROOT_PASSWORD=rp-mysql
DATABASE_URL=mysql+pymysql://root:rp-mysql@mysql:3306/deploy_platform?charset=utf8mb4
#
REDIS_PASSWORD=rp-redis
#
# Compose 自带 ES。设置页可改成自备集群。
ES_HOSTS=http://elasticsearch:9200
#
# 管理员：admin / admin123。登录后请改密。
BOOTSTRAP_ADMIN_PASSWORD=admin123
#
# 浏览器跨域白名单，逗号分隔。Compose 下前端同源反代 /api，一般不用填。
CORS_ORIGINS=
