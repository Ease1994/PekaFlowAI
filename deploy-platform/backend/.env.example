# PekaFlowAI · 启动配置（复制为 .env）
#
# 这里只放「不配就起不来 / 改了必须重启」的项。
# Redis、LDAP、企微、SMTP、ES 请在登录后「平台设置」页填写（也可被同名环境变量覆盖，如 REDIS_HOST）。

# ---- 应用 ----
DEBUG=false
# 接口文档 /docs。生产默认关，不要对公网打开，也不要在 Nginx 里反代。
# 登录后看「调用手册」即可；需要 Swagger UI 时再打开。
# API_DOCS_ENABLED=true

# ---- 数据库（必填）----
# 本地默认 SQLite：
DATABASE_URL=sqlite:///./deploy_platform.db
# 生产 / Docker：
# DATABASE_URL=mysql+pymysql://root:root123@mysql:3306/deploy_platform?charset=utf8mb4

# ---- JWT / 凭证加密 ----
# 留空即可：首次启动会自动生成随机密钥，存到 data/.secrets.json（跟着数据卷走，
# 重启不变）。每套部署因此各自独立，不再是全世界共用一个源码里的默认值。
#
# 只有以下情况才需要手动设置：
#   - 多副本部署且各副本数据卷不共享 —— 必须显式设成同一个值，否则 A 签发的
#     token 到 B 上验不过，会不停掉线
#   - 想用外部密钥管理
# 手动设置时用足够长的随机值，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_EXPIRE_SECONDS=86400
# AES_KEY=
